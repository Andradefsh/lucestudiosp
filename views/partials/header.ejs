<script src="/js/translation.js"></script>

<header id="header">
  <div class="header-inner">
    <div class="logo-wrap">
      <div class="logo">
        <a href="/">
          <img
            src="/images/logo.webp"
            width="130"
            height="65"
            alt="Logo Luce Studio"
          />
        </a>
      </div>
    </div>

    <nav class="desktop-nav" data-nav-aria aria-label="Navegação principal">
      <ul>
        <li><a href="/empresa" data-i18n-nav="company">Empresa</a></li>
        <li><a href="/portifolio" data-i18n-nav="portfolio">Portifólio</a></li>
        <li><a href="/midia" data-i18n-nav="media">Na mídia</a></li>
        <li><a href="/produtos" data-i18n-nav="products">Produtos</a></li>
        <li><a href="/contato" data-i18n-nav="contact">Fale Conosco</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <div class="social-links" aria-label="Redes sociais">
        <a
          href="https://facebook.com"
          target="_blank"
          rel="noreferrer"
          aria-label="Facebook"
        >
          <img
            src="https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/facebook.svg"
            alt="Facebook"
          />
        </a>
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noreferrer"
          aria-label="Instagram"
        >
          <img
            src="https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/instagram.svg"
            alt="Instagram"
          />
        </a>
        <a
          href="https://linkedin.com"
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn"
        >
          <img
            src="https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/linkedin.svg"
            alt="LinkedIn"
          />
        </a>
      </div>

      <div class="lang-select-wrap" aria-label="Seleção de idioma">
        <button
          type="button"
          class="lang-trigger"
          aria-label="Selecionar idioma"
        >
          <img
            class="flag"
            src="https://flagcdn.com/w20/br.webp"
            alt="Brasil"
            data-flag-image
          />
          <span class="lang-label" data-lang-label>PT</span>
          <svg class="lang-caret" viewBox="0 0 20 20" aria-hidden="true">
            <path
              d="M5 7.5L10 12.5L15 7.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <select
          aria-label="Selecionar idioma"
          class="lang-select"
          data-lang-select
        >
          <option value="pt" selected>Português (BR)</option>
          <option value="en">English (US)</option>
        </select>
      </div>
    </div>
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: gray;
    z-index: 1000;
    border-bottom: 1px solid rgba(17, 24, 39, 0.08);
  }

  .header-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 18px 32px;
    flex-wrap: nowrap;
  }

  .logo-wrap {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    min-width: 130px;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .desktop-nav {
    flex: 1 1 auto;
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
    list-style: none;
    gap: 22px;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .desktop-nav a {
    text-decoration: none;
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: color 0.3s ease;
    white-space: nowrap;
  }

  .desktop-nav a:hover,
  .desktop-nav a:focus-visible {
    color: #f3f4f6;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .desktop-nav a:focus-visible,
  .social-links a:focus-visible,
  .lang-trigger:focus-visible,
  .lang-select:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: flex-end;
    flex: 0 0 auto;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    transition:
      background 0.2s ease,
      transform 0.2s ease;
    flex-shrink: 0;
  }

  .social-links a:hover,
  .social-links a:focus-visible {
    background: rgba(255, 255, 255, 0.16);
    transform: translateY(-1px);
  }

  .social-links img {
    width: 14px;
    height: 14px;
    filter: brightness(0) invert(1) !important;
    opacity: 1;
  }

  .social-links a:hover img,
  .social-links a:focus-visible img {
    filter: brightness(0) invert(1) !important;
    opacity: 1;
  }

  .lang-select-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.04);
    min-width: 110px;
    width: 110px;
    height: 38px;
    flex-shrink: 0;
  }

  .lang-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 100%;
    padding: 0 10px;
    border: none;
    background: transparent;
    color: white;
    cursor: pointer;
    font: inherit;
  }

  .flag {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
  }

  .lang-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .lang-caret {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  .lang-select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    border: none;
    background: transparent;
    color: transparent;
  }

  .lang-select option {
    background: #111827;
    color: #ffffff;
  }

  .lang-trigger {
    outline: none;
  }

  @media (max-width: 900px) {
    .header-inner {
      padding: 14px 18px;
      gap: 12px;
    }

    .desktop-nav ul {
      gap: 12px;
    }

    .desktop-nav a {
      font-size: 0.72rem;
    }

    .header-actions {
      gap: 8px;
    }

    .social-links {
      gap: 6px;
    }

    .lang-select-wrap {
      min-width: 90px;
      width: 90px;
      height: 34px;
    }

    .lang-label {
      font-size: 0.65rem;
    }
  }

  @media (max-width: 767px) {
    .header-inner {
      padding: 14px 18px;
      gap: 12px;
    }

    .desktop-nav {
      display: none;
    }

    .logo-wrap {
      min-width: auto;
    }

    .logo img {
      width: 100px;
      height: auto;
    }

    .header-actions {
      gap: 6px;
    }

    .social-links {
      gap: 6px;
    }

    .social-links a {
      width: 24px;
      height: 24px;
    }

    .lang-select-wrap {
      min-width: 88px;
      width: 88px;
      height: 34px;
    }

    .lang-label {
      font-size: 0.65rem;
    }
  }
</style>
