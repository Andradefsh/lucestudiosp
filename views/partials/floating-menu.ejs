<script src="https://unpkg.com/lucide@latest"></script>
<nav
  class="floating-menu"
  aria-label="Menu de navegação"
  data-mobile-nav
  aria-label-pt="Menu de navegação"
  aria-label-en="Mobile navigation"
>
  <div class="menu-panel" id="menuPanel">
    <a href="#" class="menu-item" data-mobile-i18n="home">Home</a>
    <a href="#" class="menu-item" data-mobile-i18n="company">Empresa</a>
    <a href="#" class="menu-item" data-mobile-i18n="portfolio">Portfólio</a>
    <a href="#" class="menu-item" data-mobile-i18n="products">Produtos</a>
    <a href="#" class="menu-item" data-mobile-i18n="contact">Fale Conosco</a>
  </div>

  <button
    type="button"
    class="menu-toggle"
    id="menuToggle"
    aria-label="Abrir menu"
    aria-expanded="false"
    aria-controls="menuPanel"
  >
    <i data-lucide="menu"></i>
  </button>
</nav>

<style>
  .floating-menu {
    position: fixed;
    right: 0;
    top: 65%;
    transform: translateY(-50%);
    display: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 0;
    z-index: 9999;
  }

  .menu-panel {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 0;
    border: 1px solid rgba(15, 23, 42, 0.09);
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.1);
    border-radius: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateX(110%);
    transition: all 0.24s ease;
    pointer-events: none;
  }

  .floating-menu.open .menu-panel {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    pointer-events: auto;
  }

  .menu-item {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 150px;
    text-decoration: none;
    color: #111827;
    background: #ffffff;
    padding: 16px 18px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.02em;
    border-radius: 0;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    transition:
      background 0.2s ease,
      padding-left 0.2s ease;
    white-space: nowrap;
  }

  .menu-item:last-child {
    border-bottom: none;
  }

  .menu-item:hover {
    background: #f3f4f6;
    padding-left: 20px;
  }

  .menu-item:focus-visible,
  .menu-toggle:focus-visible {
    outline: 2px solid #111827;
    outline-offset: 2px;
  }

  .menu-toggle {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(15, 23, 42, 1);
    border-radius: 0;
    background: #4b5563;
    color: #ffffff;
    font-size: 26px;
    font-weight: 400;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.1);
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .menu-toggle svg {
    width: 20px;
    height: 20px;
    stroke-width: 2.2;
    color: currentColor;
  }

  .menu-toggle:hover {
    transform: translateX(-1px);
    background: #374151;
  }

  .menu-toggle:active {
    transform: translateX(-1px) scale(0.98);
  }

  .floating-menu.open .menu-toggle {
    background: #4b5563;
    color: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
  }

  @media (max-width: 767px) {
    .floating-menu {
      display: flex;
    }
  }

  @media (min-width: 768px) {
    .floating-menu {
      display: none !important;
    }
  }
</style>

<script>
  (() => {
    const floatingMenu = document.querySelector(".floating-menu");
    const menuToggle = document.getElementById("menuToggle");

    const setMenuState = (isOpen) => {
      if (!floatingMenu || !menuToggle) return;

      floatingMenu.classList.toggle("open", isOpen);
      menuToggle.setAttribute("aria-expanded", String(isOpen));

      menuToggle.innerHTML = isOpen
        ? '<i data-lucide="x"></i>'
        : '<i data-lucide="menu"></i>';

      if (window.lucide && typeof lucide.createIcons === "function") {
        lucide.createIcons();
      }
    };

    setMenuState(false);

    menuToggle.addEventListener("click", () => {
      const isOpen = !floatingMenu.classList.contains("open");
      setMenuState(isOpen);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && floatingMenu.classList.contains("open")) {
        setMenuState(false);
        menuToggle.focus();
      }
    });
  })();
</script>
