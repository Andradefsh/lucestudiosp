<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Produtos - Luce Studio . São Paulo</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <header id="site-header">
        <div class="logo">
            <a href="/" style="text-decoration: none; color: inherit; display: block;">
                <h1>LUCE STUDIO</h1>
                <span>Lighting Design & Solutions</span>
            </a>
        </div>
        <nav class="desktop-nav">
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/empresa">Empresa</a></li>
                <li><a href="/portifolio">Portifólio</a></li>
                <li><a href="/produtos" class="active">Produtos</a></li>
                <li><a href="/midia">Na Mídia</a></li>
                <li><a href="/faleconosco">Fale Conosco</a></li>
            </ul>
        </nav>
    </header>


    <!-- CONTEÚDO PRINCIPAL: PORTFÓLIO -->
    <main id="PAGES_CONTAINER" class="content-page">
      <section class="portfolio-section" style="padding: 60px 20px;">
        <div class="container" style="max-width: 1200px; margin: 0 auto;">
          
          <div class="portfolio-header" style="margin-bottom: 40px;">
            <span class="sub-heading" style="font-size: 12px; letter-spacing: 0.1em; color: #666;">LIGHTING PROJECTS</span>
            <h2 class="main-heading" style="font-size: 22px; letter-spacing: 0.05em; font-weight: bold; margin-top: 5px;">
              <a href="https://www.lucestudiosp.com/portifolio" style="text-decoration: none; color: #000;">PORTIFÓLIO</a>
            </h2>
          </div>

          <div class="portfolio-grid" style="display: flex; flex-direction: column; gap: 40px;">
            
            <div class="portfolio-item" style="background-image: url('https://static.wixstatic.com/media/f7d45f_c4a6c5e064e54360a4ba3ef41b8b7560~mv2.jpg/v1/fill/w_960,h_682,al_c,q_85,enc_avif,quality_auto/f7d45f_c4a6c5e064e54360a4ba3ef41b8b7560~mv2.jpg'); background-size: cover; background-position: center; height: 500px; display: flex; align-items: flex-end; justify-content: flex-end; padding: 30px;">
              <p style="margin: 0;">
                <a href="https://www.lucestudiosp.com/blog" style="color: #fff; text-decoration: none; font-size: 15px; letter-spacing: 0.05em; background: rgba(0,0,0,0.4); padding: 8px 15px;">CASACOR SÃO PAULO 2017</a>
              </p>
            </div>

            <div class="portfolio-item" style="background-image: url('https://static.wixstatic.com/media/f7d45f_6e6ea0c10bbe4bd6b156687bba3ac9b0~mv2.jpg/v1/fill/w_1266,h_900,al_c,q_85,enc_avif,quality_auto/f7d45f_6e6ea0c10bbe4bd6b156687bba3ac9b0~mv2.jpg'); background-size: cover; background-position: center; height: 500px; display: flex; align-items: flex-end; justify-content: flex-end; padding: 30px;">
              <p style="margin: 0;">
                <a href="https://www.lucestudiosp.com/blog" style="color: #fff; text-decoration: none; font-size: 15px; letter-spacing: 0.05em; background: rgba(0,0,0,0.4); padding: 8px 15px;">RETINIC CLINIC</a>
              </p>
            </div>

            <div class="portfolio-item" style="background-image: url('https://static.wixstatic.com/media/f7d45f_a6a46c35a9fd4584bcfe4538aa26a713~mv2_d_5575_3689_s_4_2.jpg/v1/fill/w_1293,h_919,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/f7d45f_a6a46c35a9fd4584bcfe4538aa26a713~mv2_d_5575_3689_s_4_2.jpg'); background-size: cover; background-position: center; height: 500px;">
            </div>

          </div>
        </div>
      </section>
    </main>

    <!-- RODAPÉ -->
    <footer id="SITE_FOOTER" class="site-footer" style="background: #111; color: #fff; padding: 60px 20px;">
        <div class="container" style="max-width: 800px; margin: 0 auto; text-align: center;">
            <h2 style="font-size: 20px; letter-spacing: 0.1em; margin-bottom: 30px;">FALE CONOSCO</h2>
            
            <form class="contact-form" style="display: flex; flex-direction: column; gap: 15px;">
                <input type="email" name="email" placeholder="Email *" required style="padding: 12px; background: transparent; border: 1px solid #444; color: #fff;">
                <input type="text" name="nome" placeholder="Nome *" required style="padding: 12px; background: transparent; border: 1px solid #444; color: #fff;">
                <input type="text" name="assunto" placeholder="Assunto" style="padding: 12px; background: transparent; border: 1px solid #444; color: #fff;">
                <textarea name="mensagem" placeholder="Mensagem" rows="4" style="padding: 12px; background: transparent; border: 1px solid #444; color: #fff;"></textarea>
                <button type="submit" style="padding: 12px; background: #fff; color: #000; font-weight: bold; border: none; cursor: pointer; margin-top: 10px;">Enviar</button>
            </form>
        </div>
    </footer>

</body>
</html>