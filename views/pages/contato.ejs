<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <title>Fale Conosco - Luce Studio . São Paulo</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include('../partials/header.ejs') %>

    <main class="content-page">
      <div class="container">
        <h2>FALE CONOSCO</h2>
        <div class="contact-info">
          <p><strong>T.</strong> <%= infoEmpresa.telefone %></p>
          <p><strong>C.</strong> <%= infoEmpresa.celular %></p>
          <p><%= infoEmpresa.endereco %></p>
        </div>
        <form id="contact-form">
          <input type="text" placeholder="Seu Nome" required />
          <input type="email" placeholder="Seu E-mail" required />
          <textarea placeholder="Sua Mensagem" rows="5" required></textarea>
          <button type="submit" class="btn-primary">Enviar</button>
          <p
            id="form-msg"
            style="display: none; color: #2e7d32; margin-top: 10px"
          >
            Mensagem enviada com sucesso!
          </p>
        </form>
      </div>
    </main>

    <%- include('../partials/floating-menu') %> <%-
    include('../partials/footer') %>

    <script src="/js/script.js"></script>
  </body>
</html>
