<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <title>Produtos - Luce Studio . São Paulo</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include('../partials/header.ejs') %>

    <!-- CONTEÚDO PRINCIPAL: PORTFÓLIO -->
    <main id="PAGES_CONTAINER" class="content-page">
      <section class="portfolio-section" style="padding: 60px 20px">
        <div class="container" style="max-width: 1200px; margin: 0 auto">
          <div class="portfolio-header" style="margin-bottom: 40px">
            <span
              class="sub-heading"
              style="font-size: 12px; letter-spacing: 0.1em; color: #666"
              >LIGHTING PROJECTS</span
            >
            <h2
              class="main-heading"
              style="
                font-size: 22px;
                letter-spacing: 0.05em;
                font-weight: bold;
                margin-top: 5px;
              "
            >
              <a
                href="https://www.lucestudiosp.com/portifolio"
                style="text-decoration: none; color: #000"
                >PORTIFÓLIO</a
              >
            </h2>
          </div>

          <div
            class="portfolio-grid"
            style="display: flex; flex-direction: column; gap: 40px"
          >
            <div
              class="portfolio-item"
              style="
                background-image: url(&quot;https://static.wixstatic.com/media/f7d45f_c4a6c5e064e54360a4ba3ef41b8b7560~mv2.jpg/v1/fill/w_960,h_682,al_c,q_85,enc_avif,quality_auto/f7d45f_c4a6c5e064e54360a4ba3ef41b8b7560~mv2.jpg&quot;);
                background-size: cover;
                background-position: center;
                height: 500px;
                display: flex;
                align-items: flex-end;
                justify-content: flex-end;
                padding: 30px;
              "
            >
              <p style="margin: 0">
                <a
                  href="https://www.lucestudiosp.com/blog"
                  style="
                    color: #fff;
                    text-decoration: none;
                    font-size: 15px;
                    letter-spacing: 0.05em;
                    background: rgba(0, 0, 0, 0.4);
                    padding: 8px 15px;
                  "
                  >CASACOR SÃO PAULO 2017</a
                >
              </p>
            </div>

            <div
              class="portfolio-item"
              style="
                background-image: url(&quot;https://static.wixstatic.com/media/f7d45f_6e6ea0c10bbe4bd6b156687bba3ac9b0~mv2.jpg/v1/fill/w_1266,h_900,al_c,q_85,enc_avif,quality_auto/f7d45f_6e6ea0c10bbe4bd6b156687bba3ac9b0~mv2.jpg&quot;);
                background-size: cover;
                background-position: center;
                height: 500px;
                display: flex;
                align-items: flex-end;
                justify-content: flex-end;
                padding: 30px;
              "
            >
              <p style="margin: 0">
                <a
                  href="https://www.lucestudiosp.com/blog"
                  style="
                    color: #fff;
                    text-decoration: none;
                    font-size: 15px;
                    letter-spacing: 0.05em;
                    background: rgba(0, 0, 0, 0.4);
                    padding: 8px 15px;
                  "
                  >RETINIC CLINIC</a
                >
              </p>
            </div>

            <div
              class="portfolio-item"
              style="
                background-image: url(&quot;https://static.wixstatic.com/media/f7d45f_a6a46c35a9fd4584bcfe4538aa26a713~mv2_d_5575_3689_s_4_2.jpg/v1/fill/w_1293,h_919,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/f7d45f_a6a46c35a9fd4584bcfe4538aa26a713~mv2_d_5575_3689_s_4_2.jpg&quot;);
                background-size: cover;
                background-position: center;
                height: 500px;
              "
            ></div>
          </div>
        </div>
      </section>
    </main>

    <%- include('../partials/floating-menu') %> <%-
    include('../partials/footer') %>
  </body>
</html>
