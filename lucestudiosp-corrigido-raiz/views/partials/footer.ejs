<link href="/css/footer.css" rel="stylesheet" />

<footer>
  <div class="footer-contact-area" id="contato">
    <div class="footer-inner">
      <div class="footer-contact">
        <div class="footer-form-heading">
          <span aria-hidden="true"></span>
          <h2 data-i18n-footer="contactTitle">Fale conosco</h2>
        </div>
        <form
          class="footer-form"
          id="footer-contact-form"
          action="/contato"
          method="post"
        >
          <label for="footer-email" data-i18n-footer="email">E-mail *</label>
          <input
            id="footer-email"
            name="email"
            type="email"
            placeholder="E-mail *"
            data-i18n-placeholder="email"
            autocomplete="email"
            required
          />
          <label for="footer-name" data-i18n-footer="name">Nome *</label>
          <input
            id="footer-name"
            name="name"
            type="text"
            placeholder="Nome *"
            data-i18n-placeholder="name"
            autocomplete="name"
            required
          />
          <label for="footer-subject" data-i18n-footer="subject">Assunto</label>
          <input
            id="footer-subject"
            name="subject"
            type="text"
            placeholder="Assunto"
            data-i18n-placeholder="subject"
          />
          <label for="footer-message" data-i18n-footer="message"
            >Mensagem</label
          >
          <textarea
            id="footer-message"
            name="message"
            placeholder="Mensagem"
            data-i18n-placeholder="message"
            rows="5"
            required
          ></textarea>
          <div class="footer-form-actions">
            <button class="footer-submit" type="submit">Enviar</button>
            <p
              class="footer-form-message"
              role="status"
              aria-live="polite"
              hidden
            >
              <span data-i18n-footer="success"
                >Mensagem enviada com sucesso!</span
              >
            </p>
          </div>
        </form>
      </div>

      <div class="footer-location">
        <address class="footer-address">
          <strong>Luce Studio</strong>
          <strong data-i18n-footer="contactTitle">Fale conosco</strong>
          <span><%= infoEmpresa.endereco %></span>
          <a href="tel:+551132948177">T. <%= infoEmpresa.telefone %></a>
          <a href="tel:+5511971900732">C. <%= infoEmpresa.celular %></a>
        </address>
        <iframe
          class="footer-map"
          src="https://www.google.com/maps?q=Av.+Brigadeiro+Faria+Lima,+1597,+S%C3%A3o+Paulo,+SP&output=embed"
          title="Localização da Luce Studio em São Paulo"
          data-i18n-map-title
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <a
        class="footer-brand"
        href="/"
        aria-label="Luce Studio - página inicial"
      >
        <img
          src="/images/logo-2.webp"
          alt=""
          class="footer-logo"
          width="133"
          height="79"
          loading="lazy"
          decoding="async"
        />
      </a>
      <nav class="social-links" aria-label="Redes sociais" data-i18n-social>
        <a
          href="https://www.facebook.com/lucestudiosp/?locale=pt_BR"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          ><img
            src="/images/facebook-2.webp"
            alt=""
            width="16"
            height="16"
            loading="lazy"
            decoding="async"
        /></a>
        <a
          href="https://www.instagram.com/lucestudiosp/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          ><img
            src="/images/instagram-2.webp"
            alt=""
            width="16"
            height="16"
            loading="lazy"
            decoding="async"
        /></a>
        <a
          href="https://br.linkedin.com/in/julianaramacciotti"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          ><img
            src="/images/icon-linkedin.png"
            alt=""
            width="16"
            height="16"
            loading="lazy"
            decoding="async"
        /></a>
      </nav>
      <small class="footer-copy"
        >&copy; 2026 Luce Studio.
        <span data-i18n-footer="rights"
          >Todos os direitos reservados.</span
        ></small
      >
    </div>
  </div>
</footer>
