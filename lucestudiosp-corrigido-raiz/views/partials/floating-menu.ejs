
<nav class="floating-menu" aria-label="Menu mobile">
  <div class="menu-panel" id="menuPanel">
    <a href="/" class="menu-item" data-mobile-i18n="home">Home</a>
    <a href="/empresa" class="menu-item" data-mobile-i18n="company">Empresa</a>
    <a href="/portifolio" class="menu-item" data-mobile-i18n="portfolio">Portfólio</a>
    <a href="/produtos" class="menu-item" data-mobile-i18n="products">Produtos</a>
    <a href="/midia" class="menu-item" data-mobile-i18n="media">Na mídia</a>
    <a href="/faleconosco" class="menu-item" data-mobile-i18n="contact">Fale Conosco</a>
  </div>
  <button type="button" class="menu-toggle" id="menuToggle" aria-label="Abrir menu" aria-expanded="false">☰</button>
</nav>
<style>
@media(max-width:760px){
.floating-menu{position:fixed;right:15px;bottom:18px;display:flex;flex-direction:column;align-items:flex-end;z-index:1100}
.menu-panel{display:flex;flex-direction:column;background:rgba(255,255,255,.98);border:1px solid #ddd;box-shadow:0 8px 28px rgba(0,0,0,.12);margin-bottom:8px;opacity:0;visibility:hidden;transform:translateY(8px);transition:.2s}
.floating-menu.open .menu-panel{opacity:1;visibility:visible;transform:none}
.menu-item{padding:9px 16px;text-decoration:none;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#333;border-bottom:1px solid #eee}
.menu-item:last-child{border-bottom:0}.menu-toggle{width:45px;height:45px;border:1px solid #333;background:#333;color:#fff;cursor:pointer;font-size:18px}
}
</style>
<script>
document.addEventListener("DOMContentLoaded",()=>{
 const m=document.querySelector(".floating-menu"), b=document.getElementById("menuToggle");
 if(!m||!b)return;
 b.addEventListener("click",()=>{const open=m.classList.toggle("open");b.setAttribute("aria-expanded",open?"true":"false");b.setAttribute("aria-label",open?"Fechar menu":"Abrir menu")});
});
</script>
