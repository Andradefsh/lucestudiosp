<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Conheça a seleção de luminárias e soluções que complementam os projetos de iluminação da Luce Studio." />
    <meta name="theme-color" content="#666666" />
    <meta property="og:title" content="Produtos | Luce Studio" />
    <meta property="og:description" content="Conheça a seleção de luminárias e soluções que complementam os projetos de iluminação da Luce Studio." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="<%= canonicalUrl %>" />
    <meta property="og:image" content="https://lucestudiosp.com/images/logo.webp" />
    <meta property="og:site_name" content="Luce Studio" />
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <title>Produtos | Luce Studio</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include('../partials/header.ejs') %>

    <main class="content-page">
      <div class="container">
        <header class="page-head">
          <span class="eyebrow">Lighting Projects</span>
          <h1>Produtos Exclusivos</h1>
          <p>
            Curadoria de luminárias e soluções de controle que complementam os
            projetos de iluminação da Luce Studio.
          </p>
        </header>
        <div class="products-gallery">
          <figure class="product-card">
            <img
              src="/images/produto-luminaria-ambiente.webp"
              alt="Luminária Luce em ambiente"
            width="1351" height="679" loading="lazy" decoding="async" />
            <figcaption>Luminária · Ambiente</figcaption>
          </figure>
          <figure class="product-card">
            <img
              src="/images/produto-luminaria-vinho.webp"
              alt="Luminária Luce"
            width="1351" height="679" loading="lazy" decoding="async" />
            <figcaption>Luminária · Coleção</figcaption>
          </figure>
          <figure class="product-card">
            <img src="/images/produto-luminaria.webp" alt="Luminária Luce" width="1351" height="679" loading="lazy" decoding="async" />
            <figcaption>Luminária · Design</figcaption>
          </figure>
        </div>
      </div>
    </main>
    <%- include('../partials/floating-menu') %><%- include('../partials/footer')
    %>
  </body>
</html>