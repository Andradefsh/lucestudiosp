<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= infoEmpresa.titulo %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<%- include('../partials/header.ejs') %>

<main>
  <section class="hero">
    <img class="hero-image" src="/images/produto-luminaria-ambiente.jpg" alt="Projeto de iluminação Luce Studio">
    <div class="hero-content">
      <div class="hero-kicker">Luce Studio</div>
      <h1 class="hero-title">Projetos executados</h1>
      <p class="hero-sub">Lighting Design · São Paulo</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <span class="section-kicker">Lighting</span>
        <h2 class="section-title">Solutions</h2>
        <div class="section-rule"></div>
      </div>
      <div class="home-links">
        <a class="home-link" href="/portifolio">
          <img src="/images/produto-luminaria-vinho.jpg" alt="Portfólio">
          <span>Portfólio</span>
        </a>
        <a class="home-link" href="/produtos">
          <img src="/images/produto-luminaria.jpg" alt="Produtos exclusivos">
          <span>Exclusive Products</span>
        </a>
        <a class="home-link" href="/empresa">
          <img src="/images/perfil-equipe.jpg" alt="Luce Studio">
          <span>Luce Studio</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container intro">
      <div class="intro-image"><img src="/images/perfil-equipe.jpg" alt="Luce Studio"></div>
      <article>
        <span class="eyebrow">Juliana Ramacciotti</span>
        <h2>Arquiteta e Lighting Designer</h2>
        <p>A Luce Studio é especializada em soluções de iluminação, unindo estética arquitetônica, tecnologia e desempenho para transformar espaços.</p>
        <p>Fundada em 2008, a empresa atua em projetos residenciais, corporativos, comerciais e institucionais.</p>
        <a class="text-link" href="/empresa">A empresa &rarr;</a>
      </article>
    </div>
  </section>
</main>
<%- include('../partials/floating-menu') %>
<%- include('../partials/footer') %>
<script src="/js/translation.js"></script>
</body></html>
