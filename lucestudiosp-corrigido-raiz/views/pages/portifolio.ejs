              width="1266"
              height="900"
              loading="lazy"
              decoding="async"
            /><span class="portfolio-caption"
              ><small>Lighting Design</small
              ><strong>Retinic Clinic</strong></span
            ></a
          >
          <a class="portfolio-item" href="/blog"
            ><img
              src="https://static.wixstatic.com/media/f7d45f_a6a46c35a9fd4584bcfe4538aa26a713~mv2_d_5575_3689_s_4_2.jpg/v1/fill/w_1293,h_919,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/f7d45f_a6a46c35a9fd4584bcfe4538aa26a713~mv2_d_5575_3689_s_4_2.jpg"
              alt="Projeto Luce Studio"
              width="1293"
              height="919"
              loading="lazy"
              decoding="async"
            /><span class="portfolio-caption"
              ><small>Projetos</small><strong>Lighting Design</strong></span
            ></a
          >
          <a class="portfolio-item" href="/blog"
            ><img
              src="/images/produto-luminaria-ambiente.webp"
              alt="Projeto de iluminação"
              width="1351"
              height="679"
              loading="lazy"
              decoding="async"
            /><span class="portfolio-caption"
              ><small>Lighting Design</small
              ><strong>São Paulo 2020</strong></span
            ></a
          >
          <a class="portfolio-item" href="/blog"
            ><img
              src="/images/produto-luminaria-vinho.webp"
              alt="Luce Studio"
              width="1351"
              height="679"
              loading="lazy"
              decoding="async"
            /><span class="portfolio-caption"
              ><small>Projeto</small><strong>Luce Studio</strong></span
            ></a
          >
          <a class="portfolio-item" href="/blog"
            ><img
              src="/images/produto-luminaria.webp"
              alt="Luce Studio"
              width="1351"
              height="679"
              loading="lazy"
              decoding="async"
            /><span
              class="portfolio-caption"
              ><small>Lighting</small><strong>Solutions</strong></span
            ></a
