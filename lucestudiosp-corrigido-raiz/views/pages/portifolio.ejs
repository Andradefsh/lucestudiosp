<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Conheça o portfólio de projetos de iluminação desenvolvidos pela Luce Studio." />
    <meta name="theme-color" content="#666666" />
    <meta property="og:title" content="Portfólio | Luce Studio" />
    <meta property="og:description" content="Conheça o portfólio de projetos de iluminação desenvolvidos pela Luce Studio." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="<%= canonicalUrl %>" />
    <meta property="og:image" content="https://lucestudiosp.com/images/logo.webp" />
    <meta property="og:site_name" content="Luce Studio" />
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <title>Portfólio | Luce Studio</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include('../partials/header.ejs') %>

    <main class="content-page">
      <div class="container">
        <div class="page-head">
          <span class="eyebrow">Lighting Projects</span>
          <h1>Portfólio</h1>
          <p>
            Projetos de iluminação desenvolvidos pela Luce Studio em diferentes
