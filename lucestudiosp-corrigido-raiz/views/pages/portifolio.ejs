              alt="CASACOR São Paulo 2017"
              width="960"
              height="682"
              fetchpriority="high"
              decoding="async"
            /><span class="portfolio-caption"
              ><small>Lighting Design</small
              ><strong>CASACOR São Paulo 2017</strong></span
            ></a
          >
          <a class="portfolio-item" href="/blog"
            ><img
              src="https://static.wixstatic.com/media/f7d45f_6e6ea0c10bbe4bd6b156687bba3ac9b0~mv2.jpg/v1/fill/w_1266,h_900,al_c,q_85,enc_avif,quality_auto/f7d45f_6e6ea0c10bbe4bd6b156687bba3ac9b0~mv2.jpg"
